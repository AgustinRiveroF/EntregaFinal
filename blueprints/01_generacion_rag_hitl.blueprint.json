{
  "name": "FINAL - Pipeline IA RAG + HITL + Resiliencia",
  "scenarioId": 6189006,
  "scheduleSeconds": 900,
  "architecture": {
    "trigger": "Airtable Watch Records sobre Contenido / Última modificación",
    "router": [
      {
        "route": "Aprobación HITL",
        "condition": "Aprobado = true AND Estado = En revisión",
        "actions": [
          "Actualizar Estado a Publicado",
          "Copiar Borrador IA a Resultado final",
          "Registrar fecha de ejecución",
          "Notificar publicación en Slack",
          "Crear Log de publicación exitosa"
        ],
        "errorHandler": [
          "Registrar AIRTABLE_UPDATE_ERROR en Airtable",
          "Alertar error de publicación en Slack",
          "Retry/Break: 3 intentos, intervalo 1 minuto"
        ]
      },
      {
        "route": "Rechazo HITL",
        "condition": "Estado = Rechazado AND Rechazo procesado != true",
        "actions": [
          "Notificar rechazo en Slack",
          "Registrar Log Rechazado",
          "Marcar Rechazo procesado = true",
          "No publicar"
        ]
      },
      {
        "route": "Validación de datos incompletos",
        "condition": "Estado = Generando AND Idea Semilla vacía AND Dato incompleto registrado != true",
        "actions": [
          "Registrar MISSING_IDEA_SEED en Errores",
          "Alertar en Slack",
          "Marcar Dato incompleto registrado = true",
          "No consumir IA"
        ]
      },
      {
        "route": "Generación RAG",
        "condition": "Estado = Generando AND Idea Semilla no vacía",
        "actions": [
          "Buscar hasta 20 registros en Base de Conocimiento",
          "Agregar Tema + Contenido",
          "Generar borrador con GPT-5 nano",
          "Actualizar Estado a En revisión",
          "Forzar Aprobado = false",
          "Notificar revisión en Slack",
          "Registrar Log de generación"
        ],
        "errorHandler": [
          "Registrar OPENAI_RUNTIME_ERROR en Airtable",
          "Alertar error IA en Slack",
          "Retry/Break: 3 intentos, intervalo 1 minuto"
        ]
      }
    ]
  },
  "runtimeValidation": {
    "generationRAG": "PASS",
    "approvalHITL": "PASS",
    "rejection": "PASS",
    "missingIdeaSeed": "PASS",
    "publicationErrorHandler": "PASS",
    "antiLoop": "PASS"
  },
  "security": [
    "No se incluyen API keys ni secretos",
    "Validación antes del consumo de IA",
    "HITL obligatorio antes de publicación",
    "RAG limitado a contexto privado",
    "Logs y errores separados",
    "Protección anti-loop para rechazo y dato incompleto"
  ],
  "note": "Snapshot técnico sanitizado de la arquitectura final. Las credenciales reales permanecen únicamente en Make."
}
