  "connections": {
    "airtable": "todopara's Airtable OAuth connection",
    "slack": "todopara spam's Slack credentials"
  },
  "modules": [
    {"id": 2, "app": "Airtable", "name": "Watch Records", "table": "Contenido", "triggerField": "Ultima modificacion"},
    {"id": 9, "app": "Make", "name": "Router HITL consolidado", "routes": 4},
    {"id": 17, "app": "Airtable", "name": "Generacion - Buscar conocimiento", "table": "Base de Conocimiento", "maxRecords": 20},
    {"id": 18, "app": "Tools", "name": "Generacion - Unir contexto RAG", "input": "Tema + Contenido"},
    {"id": 19, "app": "OpenAI", "name": "Generacion - Generar borrador", "model": "gpt-5-nano", "maxTokens": 700, "promptUses": ["Idea Semilla", "contexto RAG agregado"]},
    {"id": 21, "app": "Airtable", "name": "Generacion - Enviar a revision", "updates": ["Estado=En revision", "Aprobado=false", "Borrador IA=resultado IA"]},
    {"id": 22, "app": "Slack", "name": "Generacion - Avisar revision"},
    {"id": 23, "app": "Airtable", "name": "Generacion - Registrar ejecucion", "table": "Logs"},
    {"id": 10, "app": "Airtable", "name": "Aprobado - Publicar", "updates": ["Estado=Publicado", "Resultado final=Borrador IA"]},
    {"id": 13, "app": "Slack", "name": "Aprobado - Notificar publicacion"},
    {"id": 25, "app": "Airtable", "name": "Aprobado - Registrar publicacion exitosa", "table": "Logs"},
    {"id": 11, "app": "Slack", "name": "Rechazado - Notificar Slack"},
    {"id": 14, "app": "Airtable", "name": "Rechazado - Registrar log", "table": "Logs"},
    {"id": 31, "app": "Airtable", "name": "Rechazado - Marcar procesado", "updates": ["Rechazo procesado=true"]},
    {"id": 12, "app": "Airtable", "name": "Incompleto - Registrar error", "table": "Errores"},
    {"id": 15, "app": "Slack", "name": "Incompleto - Avisar Slack"},
    {"id": 32, "app": "Airtable", "name": "Incompleto - Marcar procesado", "updates": ["Dato incompleto registrado=true"]},
    {"id": 20, "app": "Airtable", "name": "Generacion - Registrar error IA", "table": "Errores"},
    {"id": 24, "app": "Slack", "name": "Generacion - Alertar error IA"},
    {"id": 27, "app": "Make", "name": "Generacion - Retry 3 intentos", "retry": true, "count": 3, "intervalMinutes": 1},
    {"id": 16, "app": "Airtable", "name": "Aprobado - Registrar error publicacion", "table": "Errores"},
    {"id": 26, "app": "Slack", "name": "Aprobado - Alertar error publicacion"},
    {"id": 28, "app": "Make", "name": "Aprobacion - Retry 3 intentos", "retry": true, "count": 3, "intervalMinutes": 1}
  ],
  "routes": [
    {"name": "Generar con idea", "condition": "Estado = Generando AND Idea Semilla != empty", "criticalAction": "Generar borrador con GPT-5 nano y dejar en En revision"},
    {"name": "Aprobacion HITL", "condition": "Aprobado = true AND Estado = En revision", "criticalAction": "Publicar y registrar resultado final"},
    {"name": "Solo rechazados no procesados", "condition": "Estado = Rechazado AND Rechazo procesado != true", "criticalAction": "Registrar rechazo sin salida externa"},
    {"name": "Dato incompleto no procesado", "condition": "Estado = Generando AND Idea Semilla = empty AND Dato incompleto registrado != true", "criticalAction": "Registrar error sin consumir IA"}
  ],
  "runtimeValidation": {
