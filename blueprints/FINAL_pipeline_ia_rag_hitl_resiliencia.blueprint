{
  "name": "FINAL - Pipeline IA RAG + HITL + Resiliencia",
  "scenarioId": 6189006,
  "orchestrator": "Make",
  "status": "active",
  "scheduling": {
    "type": "indefinitely",
    "intervalSeconds": 900,
    "trigger": "Airtable Watch Records sobre tabla Contenido por Ultima modificacion"
